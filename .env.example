# Akoso environment variables.
# Copy this file to .env for local development. Never commit .env.
# Every variable is validated with Zod at startup (packages/core/src/config/env.ts);
# the app refuses to start if one is missing or malformed.
# Only variables the code reads today are listed. Add a variable here, with a comment,
# in the same pull request that starts reading it.

# development | test | production
NODE_ENV=development

# The base domain. The app lives at app.<domain>, the platform admin at admin.<domain>
# and each school's public pages at <slug>.<domain> (brief section 7).
# Production: akoso.ng. Never hard-code the domain in code.
APP_BASE_DOMAIN=akoso.localhost

# Postgres connection for the least-privilege application role (no SUPERUSER, no
# BYPASSRLS, owns nothing), always through the connection pooler: PgBouncer in
# transaction mode on port 6432 locally. The local value matches docker-compose.yml and
# docker/postgres/init/01-roles.sql. A separate variable for the migration role, which
# connects straight to Postgres (port 5433 locally), arrives with the first migrations.
DATABASE_URL=postgres://akoso_app:akoso_app_local@localhost:6432/akoso_dev
